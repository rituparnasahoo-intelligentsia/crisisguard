# Copy this file to ".env" and change the password. NEVER commit ".env".
# These are local demo credentials for a database that holds fictional data only.

POSTGRES_USER=crisisguard
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=crisisguard
POSTGRES_PORT=5432

# The password in these URLs must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://crisisguard:change_me_locally@localhost:5432/crisisguard

# Tests use a SEPARATE database. Its name must end in "_test" (the tests refuse otherwise).
TEST_DATABASE_URL=postgresql://crisisguard:change_me_locally@localhost:5432/crisisguard_test
